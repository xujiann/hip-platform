<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.hip</groupId>
        <artifactId>hip-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hip-server</artifactId>
    <name>启动器（聚合各业务模块）</name>

    <dependencies>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-platform-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-platform-empi</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-platform-masterdata</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-platform-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-outpatient</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-portal</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-cdr</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hip</groupId>
            <artifactId>hip-inpatient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
